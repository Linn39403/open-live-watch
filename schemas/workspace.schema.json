{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-live-watch:workspace:1",
  "title": "Open Live Watch workspace v1 initial subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "sources", "screens"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/screen" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "enum": ["mock", "elf", "custom", "svd"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "symbolPath",
        "gain",
        "offset",
        "units",
        "periodMs",
        "writable"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "symbolPath": { "type": "string", "minLength": 1 },
        "gain": { "type": "number" },
        "offset": { "type": "number" },
        "units": { "type": "string" },
        "periodMs": { "type": "integer", "minimum": 1 },
        "writable": { "type": "boolean" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "rotation"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "precision": { "type": "integer", "minimum": 0, "maximum": 12 },
        "commit": { "enum": ["release", "apply"] },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7
        },
        "needleColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "rect", "settings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "numeric",
            "radial",
            "linear",
            "thermometer",
            "led",
            "slider",
            "switch",
            "button"
          ]
        },
        "title": { "type": "string" },
        "rect": { "$ref": "#/$defs/rect" },
        "binding": { "$ref": "#/$defs/binding" },
        "settings": { "$ref": "#/$defs/settings" }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "canvas", "widgets"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "const": "dashboard" },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "grid"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "grid": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } }
      }
    }
  }
}
